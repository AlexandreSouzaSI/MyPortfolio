# .env da RAIZ do projeto — usado só pelo docker-compose.yml (produção /
# VPS). Copie pra ".env" e preencha antes de rodar "docker compose up -d".
# Não commite o ".env" de verdade (já está no .gitignore).

# Senha do Postgres dentro do container (dev local pode deixar o default).
POSTGRES_PASSWORD=troque_por_uma_senha_forte

# Mesmo token usado em backend/.env — protege as rotas de escrita da API.
ADMIN_TOKEN=troque_por_um_token_forte

# URL pública do backend que o frontend vai chamar (é "inlined" no build,
# então precisa ser a URL final de produção, ex: https://api.seudominio.com).
NEXT_PUBLIC_API_URL=https://portfolio-api.amsx.online
