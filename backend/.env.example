# Copie este arquivo pra ".env" e preencha com valores reais.
# Nunca commite o ".env" de verdade — ele já está no .gitignore.

# String de conexão do Postgres.
# Local (docker-compose.yml na raiz do projeto, porta 5434 — as portas
# 5432/5433/5435/5436 já estavam em uso por outros containers):
# postgresql://postgres:postgres@localhost:5434/portfolio_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/portfolio_db?schema=public"

# Porta em que o Nest sobe localmente.
PORT=4100

# Token simples pra proteger as rotas de escrita (criar/editar/apagar
# projeto, ver mensagens de contato). Não é um sistema de login completo —
# é só um "Bearer <token>" fixo, suficiente pra um painel de admin pessoal.
# Gere um valor forte, por exemplo: openssl rand -hex 32
ADMIN_TOKEN="troque_por_um_token_forte"
